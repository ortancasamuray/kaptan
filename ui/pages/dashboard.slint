import { StandardListView, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, CircleBar, LineBar, UsageBar, IconButton, Icon, RingGauge } from "../widgets.slint";
import { Dashboard } from "../globals.slint";

export component DashboardPage inherits Rectangle {
  VerticalLayout {
    spacing: Theme.gap;

    // The gauges take the free height; the lower row is as tall as its content, so both of its
    // columns end on the same line and nothing is left empty below them.
    HorizontalLayout {
        spacing: Theme.gap;
        min-height: 200px;
        vertical-stretch: 1;
        CircleBar {
            title: @tr("CPU");
            value: Dashboard.cpu-value;
            text: Dashboard.cpu-text;
            color-a: #A8E063;
            color-b: #56AB2F;
        }
        CircleBar {
            title: @tr("MEMORY");
            value: Dashboard.mem-value;
            text: Dashboard.mem-text;
            color-a: #FFB75E;
            color-b: #ED8F03;
        }
        CircleBar {
            title: @tr("DISK");
            value: Dashboard.disk-value;
            text: Dashboard.disk-text;
            color-a: #DC2430;
            color-b: #7B4397;
            clickable: true;
            clicked => { Dashboard.open-disks(); }
        }
        if Dashboard.gpu-visible: CircleBar {
            title: @tr("GPU");
            value: Dashboard.gpu-value;
            text: Dashboard.gpu-text;
            color-a: #36D1DC;
            color-b: #5B86E5;
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        vertical-stretch: 0;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: @tr("SYSTEM INFO");
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                for item in Dashboard.system-info: Text {
                    text: item.text;
                    color: Theme.text;
                    font-size: Theme.font-normal;
                    wrap: word-wrap;
                }
                if Dashboard.temps.length > 0: Rectangle { height: 1px; background: Theme.border; }
                if Dashboard.temps.length > 0: Text {
                    text: @tr("TEMPERATURES");
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                if Dashboard.temps.length > 0: HorizontalLayout {
                    spacing: Theme.gap;
                    min-height: 150px;
                    vertical-stretch: 1;
                    for t in Dashboard.temps: VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: t.name;
                            color: Theme.text;
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        RingGauge {
                            vertical-stretch: 1;
                            zones: true;
                            value: t.percent;
                            warm: t.warm;
                            hot: t.hot;
                            text: t.text;
                            font-size: max(12px, min(self.width, self.height) / 6.5);
                            color-a: t.level == 2 ? #ff7a7a : t.level == 1 ? #ffe066 : t.level == 0 ? #6fc3ff : Theme.track;
                            color-b: t.level == 2 ? #d62f3a : t.level == 1 ? #f0a500 : t.level == 0 ? #2f6fed : Theme.track;
                        }
                        Text {
                            text: t.status;
                            color: t.level == 2 ? #e5484d : t.level == 1 ? #f0b400 : t.level == 0 ? #4f9bff : Theme.text-dim;
                            font-size: Theme.font-normal;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
        // Fixed width: the speed texts change every second and must not move the layout.
        VerticalLayout {
            width: 340px;
            spacing: Theme.gap;
            LineBar {
                title: @tr("DOWNLOAD");
                vertical-stretch: 0;
                value: Dashboard.down-value;
                text: Dashboard.down-text;
                caption: Dashboard.down-total;
                bar-color: #2fbf71;
            }
            LineBar {
                title: @tr("UPLOAD");
                vertical-stretch: 0;
                value: Dashboard.up-value;
                text: Dashboard.up-text;
                caption: Dashboard.up-total;
                bar-color: #3d8bfd;
            }
            if Dashboard.fans.length == 0: Rectangle { vertical-stretch: 1; }
            if Dashboard.fans.length > 0: Card {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: space-between;
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: @tr("FANS");
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                    for fan in Dashboard.fans: VerticalLayout {
                        spacing: 5px;
                        HorizontalLayout {
                            Text {
                                text: fan.name;
                                color: Theme.text;
                                font-size: Theme.font-normal;
                                overflow: elide;
                            }
                            Text {
                                text: fan.rpm;
                                color: Theme.text;
                                font-size: Theme.font-normal;
                                font-weight: 600;
                                horizontal-alignment: right;
                                horizontal-stretch: 1;
                            }
                        }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.track;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(fan.percent, 0, 100) / 100;
                                border-radius: 3px;
                                background: @linear-gradient(90deg, #36D1DC 0%, #5B86E5 100%);
                                animate width { duration: 300ms; easing: ease-out; }
                            }
                        }
                    }
                }
            }
        }
    }
  }

    if Dashboard.disks-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { Dashboard.disks-open = false; } }
        Card {
            width: min(parent.width - 40px, 680px);
            height: min(parent.height - 40px, dlg.preferred-height);
            TouchArea { } // clicks inside the card don't close it
            dlg := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Icon { source: @image-url("../icons/drive.svg"); width: 22px; height: 22px; y: 2px; }
                    Text {
                        text: @tr("All Disks");
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    IconButton { text: @tr("Close"); clicked => { Dashboard.disks-open = false; } }
                }
                Text {
                    text: @tr("Click a mounted partition to show it on the dashboard.");
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                }
                ListView {
                    preferred-height: min(520px, Dashboard.disk-rows.length * 62px);
                    for row in Dashboard.disk-rows: Rectangle {
                        height: row.is-disk ? 56px : 62px;
                        border-radius: 8px;
                        background: row.selected ? Theme.accent-soft
                            : row.is-disk ? Theme.bg
                            : (row.mount != "" && ta.has-hover) ? Theme.card-hover : transparent;
                        ta := TouchArea {
                            enabled: row.mount != "";
                            mouse-cursor: row.mount != "" ? pointer : default;
                            clicked => { Dashboard.select-disk(row.mount); }
                        }
                        HorizontalLayout {
                            padding-left: row.is-disk ? 12px : 30px + row.depth * 18px;
                            padding-right: 12px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            if row.is-disk: Icon {
                                source: @image-url("../icons/drive.svg");
                                tint: Theme.accent;
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2 - 8px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: row.title;
                                        color: row.mount == "" && !row.is-disk ? Theme.text-dim : Theme.text;
                                        font-size: row.is-disk ? 14px : 13px;
                                        font-weight: row.is-disk ? 700 : 600;
                                        overflow: elide;
                                    }
                                    if row.selected: Rectangle {
                                        width: badge.preferred-width + 14px;
                                        height: 18px;
                                        y: 1px;
                                        border-radius: 9px;
                                        background: Theme.accent;
                                        badge := Text {
                                            text: @tr("Shown on dashboard");
                                            color: #ffffff;
                                            font-size: 10px;
                                            font-weight: 700;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: row.size;
                                        color: Theme.text-dim;
                                        font-size: Theme.font-small;
                                        font-weight: 600;
                                    }
                                }
                                Text {
                                    text: row.subtitle;
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                if row.percent >= 0: HorizontalLayout {
                                    spacing: 10px;
                                    UsageBar { value: row.percent; y: 5px; horizontal-stretch: 1; }
                                    Text {
                                        text: row.detail;
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
